# Application Environment
NODE_ENV=development
DEBUG=true

# Server Configuration
PORT=3000
HTTPS=true

# OpenAI API Configuration
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_API_KEY=your_api_key_here
OPENAI_API_MODEL=gpt-3.5-turbo

# API Configuration
API_TIMEOUT=30000
MAX_TOKENS=1000

# Security
ALLOWED_ORIGINS=https://localhost:3000

# Development Certificates
# These will be auto-generated using npm run install-dev-certs
# CERT_FILE_PATH=certs/localhost.crt
# KEY_FILE_PATH=certs/localhost.key

# To use a different API endpoint:
# 1. Replace OPENAI_API_URL with your API endpoint
# 2. Update OPENAI_API_KEY with your API key
# 3. Make sure the API endpoint follows OpenAI's API specification
