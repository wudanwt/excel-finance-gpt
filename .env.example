# Application Environment
NODE_ENV=development
DEBUG=false

# OpenAI Compatible API Configuration
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_API_KEY=your_api_key_here
OPENAI_API_MODEL=text-davinci-003

# API Configuration
API_TIMEOUT=30000
MAX_TOKENS=1000

# Development Server
PORT=3000
HTTPS=true

# Note: After setting up the environment variables:
# 1. Copy this file to .env
# 2. Replace the API URL with your custom endpoint if using a different provider
# 3. Add your API key
# 4. Adjust other settings as needed
