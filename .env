# Application Environment
NODE_ENV=development
DEBUG=true

# OpenAI Compatible API Configuration
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_API_KEY=your_api_key_here
OPENAI_API_MODEL=text-davinci-003

# API Configuration
API_TIMEOUT=30000
MAX_TOKENS=1000

# Development Server
PORT=3000
HTTPS=true

# To use a different API endpoint:
# 1. Replace OPENAI_API_URL with your API endpoint
# 2. Update OPENAI_API_KEY with your API key
# 3. Make sure the API endpoint follows OpenAI's API specification

# Example for using a different API endpoint:
# OPENAI_API_URL=https://your-api-endpoint.com/v1
# OPENAI_API_KEY=your_custom_api_key
# OPENAI_API_MODEL=your_model_name
